# The preview stays outside search until the launch checks are completed.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
EDITOR_LEGAL_NAME=
EDITOR_SIRET=
EDITOR_ADDRESS=
EDITOR_PUBLICATION_DIRECTOR=
EDITOR_CONTACT_EMAIL=
HOST_LEGAL_NAME=
HOST_ADDRESS=
HOST_WEBSITE=

# No transmission until every required setting and recipient is verified.
LEAD_DELIVERY_VERIFIED=false
LEAD_TRANSPORT=
# Adresse expéditrice du domaine vérifié chez Resend / SMTP.
CONTACT_FROM_EMAIL=
# Boîte centrale vérifiée : utilisée si LEAD_ROUTES reste vide.
CONTACT_TO_EMAIL=
# Facultatif : sinon Reply-To est l’adresse validée du demandeur.
CONTACT_REPLY_TO_EMAIL=
# Ancien alias de CONTACT_FROM_EMAIL, conservé pour compatibilité.
LEAD_FROM=
# JSON array, each entry requires: expertise, departments (French codes),
# recipient (verified email), verified:true; optional brand (validated slug).
LEAD_ROUTES=[]
LEAD_TOKEN_SECRET=
FORM_ALLOWED_ORIGINS=https://solution-habitation.fr
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# En production, stockage Redis REST HTTPS partagé obligatoire (ex. Upstash).
# Compteurs atomiques, empreintes anti-répétition, reçus et verrous d’idempotence.
ANTISPAM_REDIS_REST_URL=
ANTISPAM_REDIS_REST_TOKEN=
# Le reverse proxy doit écraser cet en-tête avec l’IP réelle : jamais faire confiance
# à un en-tête librement fourni par le visiteur. Valeurs : x-real-ip,
# cf-connecting-ip ou x-forwarded-for (première adresse, proxy maîtrisé).
FORM_TRUSTED_IP_HEADER=x-real-ip

# Choose one transport. Never commit credentials.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Verified data controller and retention policy required before collection.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_RETENTION_MONTHS=

# Reserved for a documented CODE-V OS integration; no automatic webhook call.
CODEV_OS_WEBHOOK_URL=
CODEV_OS_WEBHOOK_SECRET=
# Film : les fichiers locaux public/media sont utilisés par défaut.
# Renseigner uniquement des URL HTTPS réelles pour un hébergement externe.
FILM_VIDEO_URL=
FILM_MOBILE_URL=
FILM_POSTER_URL=
# Date réelle de première publication, au format ISO avec fuseau ; vide = pas de VideoObject.
FILM_UPLOAD_DATE=
