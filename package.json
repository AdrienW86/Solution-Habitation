{
  "name": "solution-habitation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run validate:reseau && npm run validate:editorial && npm run audit:local-seo",
    "validate:editorial": "tsx scripts/validate-editorial.ts",
    "generate:media": "tsx scripts/generate-editorial-media.ts",
    "audit:local-seo": "tsx scripts/audit-local-seo.ts",
    "validate:reseau": "tsx scripts/validate-network.ts",
    "sync:communes": "node scripts/sync-communes.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts *.mjs *.ts *.json README.md"
  },
  "dependencies": {
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
